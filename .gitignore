# Each project's own files and extracted text stay local (copyright).
projects/*/library/raw/*
projects/*/library/extracted/*
!projects/*/library/raw/.gitkeep
!projects/*/library/extracted/.gitkeep
__pycache__/
*.pyc
.venv/
*-workspace/
projects/*/.work/
examples/*/.work/
examples/*/library/raw/*
examples/*/library/extracted/*
